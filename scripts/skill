#!/usr/bin/env python3
"""Agent Skill Hub 的无第三方依赖命令行工具。"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
import unicodedata
from pathlib import Path
from typing import Iterable


ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = ROOT / "registry.json"
NAME_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
VERSION_PATTERN = re.compile(r"^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$")
SUPPORTED_TARGETS = ("codex", "claude", "deepseek")
DECLARED_TARGETS = {
    "codex": "codex",
    "claude": "claude-code",
    "deepseek": "deepseek-harness",
}


class SkillError(Exception):
    pass


class ChineseArgumentParser(argparse.ArgumentParser):
    """将 argparse 默认帮助中的固定英文标题转换为中文。"""

    def format_help(self) -> str:
        positional_heading = "命令：\n" if self.prog == "skill" else "参数：\n"
        return (
            super()
            .format_help()
            .replace("usage: ", "用法：")
            .replace("positional arguments:\n", positional_heading)
            .replace("options:\n", "选项：\n")
            .replace("show this help message and exit", "显示帮助信息并退出")
        )


def load_registry() -> dict:
    try:
        data = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SkillError(f"找不到索引文件：{REGISTRY_PATH}") from exc
    except json.JSONDecodeError as exc:
        raise SkillError(f"registry.json 格式无效：{exc}") from exc
    if not isinstance(data, dict) or not isinstance(data.get("skills"), list):
        raise SkillError("registry.json 必须包含 'skills' 数组")
    return data


def skills_by_name() -> dict[str, dict]:
    result: dict[str, dict] = {}
    for skill in load_registry()["skills"]:
        if isinstance(skill, dict) and isinstance(skill.get("name"), str):
            result[skill["name"]] = skill
    return result


def require_skill(name: str) -> dict:
    skill = skills_by_name().get(name)
    if skill is None:
        raise SkillError(f"找不到 Skill：{name}")
    return skill


def skill_source(skill: dict) -> Path:
    raw_path = skill.get("path")
    if not isinstance(raw_path, str):
        raise SkillError(f"Skill {skill.get('name', '<未知>')} 没有有效路径")
    source = (ROOT / raw_path).resolve()
    skills_root = (ROOT / "skills").resolve()
    if source.parent != skills_root:
        raise SkillError(f"Skill 路径必须是 {skills_root} 的直接子目录：{raw_path}")
    return source


def parse_frontmatter(path: Path) -> dict[str, str]:
    try:
        content = path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise SkillError(f"缺少 SKILL.md：{path}") from exc
    lines = content.splitlines()
    if not lines or lines[0].strip() != "---":
        raise SkillError(f"{path}：YAML frontmatter 必须从第一行开始")
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration as exc:
        raise SkillError(f"{path}：YAML frontmatter 没有正确闭合") from exc
    metadata: dict[str, str] = {}
    for line in lines[1:end]:
        match = re.match(r"^([A-Za-z0-9_-]+):\s*(.*?)\s*$", line)
        if match:
            metadata[match.group(1)] = match.group(2).strip("'\"")
    return metadata


def manifest_scalar(path: Path, key: str) -> str | None:
    if not path.is_file():
        return None
    pattern = re.compile(rf"^{re.escape(key)}:\s*([^#\n]+?)\s*$", re.MULTILINE)
    match = pattern.search(path.read_text(encoding="utf-8"))
    return match.group(1).strip("'\"") if match else None


def manifest_list(path: Path, key: str) -> list[str]:
    if not path.is_file():
        return []
    lines = path.read_text(encoding="utf-8").splitlines()
    values: list[str] = []
    in_list = False
    for line in lines:
        if line == f"{key}:":
            in_list = True
            continue
        if not in_list:
            continue
        match = re.match(r"^\s+-\s+(.+?)\s*$", line)
        if match:
            values.append(match.group(1).strip("'\""))
            continue
        if line and not line[0].isspace():
            break
    return values


def validate_skill(skill: dict) -> list[str]:
    errors: list[str] = []
    name = skill.get("name")
    if not isinstance(name, str) or not NAME_PATTERN.fullmatch(name) or len(name) > 64:
        return [f"索引中的名称无效：{name!r}"]

    try:
        source = skill_source(skill)
    except SkillError as exc:
        return [str(exc)]
    if source.name != name:
        errors.append(f"{name}：目录名必须是 {name}")
    if not source.is_dir():
        errors.append(f"{name}：源目录不存在：{source}")
        return errors

    try:
        metadata = parse_frontmatter(source / "SKILL.md")
    except SkillError as exc:
        errors.append(str(exc))
        metadata = {}
    if metadata.get("name") != name:
        errors.append(f"{name}：SKILL.md 中的 name 必须与索引一致")
    description = metadata.get("description", "")
    if not description:
        errors.append(f"{name}：SKILL.md 必须包含 description")
    elif len(description) > 1024:
        errors.append(f"{name}：SKILL.md 中的 description 超过 1024 个字符")

    version = skill.get("version")
    if not isinstance(version, str) or not VERSION_PATTERN.fullmatch(version):
        errors.append(f"{name}：version 必须使用语义化版本")
    registry_description = skill.get("description")
    if not isinstance(registry_description, str) or not registry_description.strip():
        errors.append(f"{name}：索引中必须包含 description")
    targets = skill.get("targets")
    if not isinstance(targets, list) or not targets:
        errors.append(f"{name}：targets 必须是非空数组")
    elif unknown := sorted(set(targets) - set(DECLARED_TARGETS.values())):
        errors.append(f"{name}：不支持的目标客户端：{', '.join(unknown)}")

    manifest = source / "manifest.yaml"
    if not manifest.is_file():
        errors.append(f"{name}：本仓库要求提供 manifest.yaml")
    else:
        if manifest_scalar(manifest, "name") != name:
            errors.append(f"{name}：manifest 中的 name 必须与索引一致")
        if manifest_scalar(manifest, "version") != version:
            errors.append(f"{name}：manifest 中的 version 必须与索引一致")
        if manifest_scalar(manifest, "entrypoint") != "SKILL.md":
            errors.append(f"{name}：manifest 中的 entrypoint 必须是 SKILL.md")
        if set(manifest_list(manifest, "targets")) != set(targets or []):
            errors.append(f"{name}：manifest 中的 targets 必须与索引一致")
    return errors


def validate_registry(selected_name: str | None = None) -> list[str]:
    registry = load_registry()
    errors: list[str] = []
    seen: set[str] = set()
    entries = registry["skills"]
    for index, skill in enumerate(entries):
        if not isinstance(skill, dict):
            errors.append(f"索引中第 {index} 个条目必须是对象")
            continue
        name = skill.get("name")
        if selected_name is not None and name != selected_name:
            continue
        if name in seen:
            errors.append(f"索引中存在重复 Skill：{name}")
        if isinstance(name, str):
            seen.add(name)
        errors.extend(validate_skill(skill))

    if selected_name is not None and selected_name not in seen:
        errors.append(f"找不到 Skill：{selected_name}")

    if selected_name is None:
        registered_paths = {
            (ROOT / skill["path"]).resolve()
            for skill in entries
            if isinstance(skill, dict) and isinstance(skill.get("path"), str)
        }
        skills_root = ROOT / "skills"
        for skill_md in sorted(skills_root.glob("*/SKILL.md")):
            if skill_md.parent.resolve() not in registered_paths:
                errors.append(f"未登记到索引的 Skill 目录：{skill_md.parent.name}")
    return errors


def expand_targets(target: str) -> tuple[str, ...]:
    return SUPPORTED_TARGETS if target == "all" else (target,)


def project_root(project_dir: str | None) -> Path:
    if project_dir:
        root = Path(project_dir).expanduser().resolve()
        if not root.is_dir():
            raise SkillError(f"项目目录不存在：{root}")
        return root
    current = Path.cwd().resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".git").exists():
            return candidate
    return current


def target_root(target: str, scope: str, project_dir: str | None) -> Path:
    if scope == "user":
        dsh_home = Path(os.environ.get("DSH_HOME", str(Path.home() / ".dsh"))).expanduser()
        roots = {
            "codex": Path.home() / ".agents" / "skills",
            "claude": Path.home() / ".claude" / "skills",
            "deepseek": dsh_home / "skills",
        }
    else:
        base = project_root(project_dir)
        roots = {
            "codex": base / ".agents" / "skills",
            "claude": base / ".claude" / "skills",
            "deepseek": base / ".dsh" / "skills",
        }
    return roots[target]


def install_one(source: Path, destination: Path, force: bool) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists() and not force:
        raise SkillError(f"目标已存在（使用 --force 替换）：{destination}")
    if destination.is_symlink() and force:
        raise SkillError(f"拒绝替换符号链接：{destination}")

    staging_parent = Path(tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent))
    staged = staging_parent / destination.name
    backup = destination.parent / f".{destination.name}.backup-{os.getpid()}"
    try:
        shutil.copytree(source, staged, symlinks=False)
        if destination.exists():
            if backup.exists():
                raise SkillError(f"备份路径意外存在：{backup}")
            destination.rename(backup)
        staged.rename(destination)
        if backup.exists():
            shutil.rmtree(backup)
    except Exception:
        if backup.exists() and not destination.exists():
            backup.rename(destination)
        raise
    finally:
        if staging_parent.exists():
            shutil.rmtree(staging_parent)


def display_width(value: str) -> int:
    return sum(2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1 for char in value)


def pad_display(value: str, width: int) -> str:
    return value + " " * max(0, width - display_width(value))


def command_list(query: str | None = None) -> None:
    skills = list(skills_by_name().values())
    if query:
        needle = query.casefold()
        skills = [
            skill
            for skill in skills
            if needle in " ".join(
                [
                    str(skill.get("name", "")),
                    str(skill.get("description", "")),
                    " ".join(skill.get("tags", [])),
                ]
            ).casefold()
        ]
    if not skills:
        print("没有找到 Skill。")
        return
    width = max(display_width("名称"), *(display_width(str(skill["name"])) for skill in skills))
    print(f"{pad_display('名称', width)}  {pad_display('版本', 12)}  说明")
    for skill in sorted(skills, key=lambda item: item["name"]):
        print(
            f"{pad_display(skill['name'], width)}  "
            f"{pad_display(skill['version'], 12)}  {skill['description']}"
        )


def command_info(name: str) -> None:
    print(json.dumps(require_skill(name), ensure_ascii=False, indent=2))


def command_validate(name: str | None) -> None:
    errors = validate_registry(name)
    if errors:
        for error in errors:
            print(f"错误：{error}", file=sys.stderr)
        raise SkillError(f"校验失败，共发现 {len(errors)} 个错误")
    print(f"校验通过：{name or '全部 Skills'}")


def command_install(args: argparse.Namespace, force: bool = False) -> None:
    skill = require_skill(args.name)
    errors = validate_skill(skill)
    if errors:
        raise SkillError("无法安装未通过校验的 Skill：\n- " + "\n- ".join(errors))
    source = skill_source(skill)
    declared_targets = set(skill["targets"])
    for target in expand_targets(args.target):
        if DECLARED_TARGETS[target] not in declared_targets:
            raise SkillError(f"{args.name} 未声明支持目标客户端：{target}")
        destination = target_root(target, args.scope, args.project_dir) / args.name
        install_one(source, destination, force or args.force)
        print(f"已安装 {args.name} -> {target}：{destination}")


def command_uninstall(args: argparse.Namespace) -> None:
    require_skill(args.name)
    if not args.yes:
        raise SkillError("卸载时必须传入 --yes")
    for target in expand_targets(args.target):
        destination = target_root(target, args.scope, args.project_dir) / args.name
        if destination.is_symlink():
            destination.unlink()
        elif destination.is_dir():
            shutil.rmtree(destination)
        elif destination.exists():
            raise SkillError(f"拒绝删除非目录目标：{destination}")
        else:
            print(f"未安装到 {target}：{destination}")
            continue
        print(f"已从 {target} 卸载 {args.name}：{destination}")


def add_destination_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--target",
        choices=(*SUPPORTED_TARGETS, "all"),
        default="codex",
        help="目标客户端（默认：codex）",
    )
    parser.add_argument(
        "--scope",
        choices=("user", "project"),
        default="user",
        help="安装范围（默认：user）",
    )
    parser.add_argument(
        "--project-dir",
        help="project 范围使用的项目根目录；默认为最近的 Git 根目录",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = ChineseArgumentParser(prog="skill", description=__doc__)
    subparsers = parser.add_subparsers(
        dest="command", required=True, parser_class=ChineseArgumentParser
    )

    subparsers.add_parser("list", help="列出已登记的 Skills")
    search = subparsers.add_parser("search", help="搜索 Skill 名称、说明和标签")
    search.add_argument("query", metavar="关键词")
    info = subparsers.add_parser("info", help="显示 Skill 在索引中的元数据")
    info.add_argument("name", metavar="Skill名称")
    validate = subparsers.add_parser("validate", help="校验单个 Skill 或整个索引")
    validate.add_argument("name", nargs="?", metavar="Skill名称")

    install = subparsers.add_parser("install", help="安装 Skill")
    install.add_argument("name", metavar="Skill名称")
    add_destination_options(install)
    install.add_argument("--force", action="store_true", help="替换已存在的安装")

    update = subparsers.add_parser("update", help="使用仓库中的副本替换已安装的 Skill")
    update.add_argument("name", metavar="Skill名称")
    add_destination_options(update)

    uninstall = subparsers.add_parser("uninstall", help="卸载已安装的 Skill")
    uninstall.add_argument("name", metavar="Skill名称")
    add_destination_options(uninstall)
    uninstall.add_argument("--yes", action="store_true", help="确认卸载")
    return parser


def main(argv: Iterable[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "list":
            command_list()
        elif args.command == "search":
            command_list(args.query)
        elif args.command == "info":
            command_info(args.name)
        elif args.command == "validate":
            command_validate(args.name)
        elif args.command == "install":
            command_install(args)
        elif args.command == "update":
            args.force = True
            command_install(args, force=True)
        elif args.command == "uninstall":
            command_uninstall(args)
        return 0
    except SkillError as exc:
        print(f"skill: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
